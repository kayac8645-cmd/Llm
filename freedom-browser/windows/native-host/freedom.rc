#include <windows.h>

101 ICON "freedom.ico"

#ifndef FREEDOM_BOOTSTRAP
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "freedom.manifest"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,1,0,0
PRODUCTVERSION 1,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Lumo Browser project"
      VALUE "FileDescription", "Lumo Browser (Windows x86)"
      VALUE "FileVersion", "1.1.0"
      VALUE "InternalName", "LumoBrowser"
      VALUE "LegalCopyright", "MIT License. Chromium/CEF: BSD-style licenses."
      VALUE "ProductName", "Lumo Browser"
      VALUE "ProductVersion", "1.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
