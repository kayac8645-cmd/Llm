<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash screen with the Lumo mark on the brand background. -->
    <style name="Theme.Freedom" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/freedom_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/freedom_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/freedom_bg</item>
    </style>
</resources>
